# Copie os nomes para o ambiente do Compose no EasyPanel. Nao versionar valores reais.

# Obrigatorias. Gere os segredos no EasyPanel.
DJANGO_SECRET_KEY=
DJANGO_ADMIN_URL=
DJANGO_ALLOWED_HOSTS=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
FRONTEND_BASE_URL=

# URL publica da API; deixe vazia ate configurar o dominio/rota correspondente.
API_PUBLIC_BASE_URL=

# Nao configure DATABASE_URL: o entrypoint de producao a recompoe em runtime
# usando os POSTGRES_* acima e postgres:5432; use senha URL-safe.
# DJANGO_ADMIN_URL e um caminho imprevisivel terminado em "/" (nao uma URL completa).
# DJANGO_ALLOWED_HOSTS e uma lista separada por virgulas, sem esquema.

# SMTP desligado no staging inicial.
NOTIFICATION_EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DJANGO_DEFAULT_FROM_EMAIL=

# RD Station desligado enquanto credenciais e callbacks nao forem configurados.
RDSTATION_CRM_CLIENT_ID=
RDSTATION_CRM_CLIENT_SECRET=
RDSTATION_CRM_REDIRECT_URI=
RDSTATION_CRM_WEBHOOK_URL=
INTEGRATIONS_FERNET_KEY=

# OpenAI/Composio desligados no staging inicial.
AGENT_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
COMPOSIO_API_KEY=
