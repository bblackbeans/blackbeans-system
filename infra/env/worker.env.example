DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-real-env
USE_DOCKER=yes

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=blackbeans
POSTGRES_USER=blackbeans
POSTGRES_PASSWORD=blackbeans
DATABASE_URL=postgres://blackbeans:blackbeans@postgres:5432/blackbeans

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Agentes IA (mesma chave da API)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AGENT_LLM_ENABLED=1
# AGENT_STALE_DAYS=7

# RD Station CRM (mesmas vars da API)
# RDSTATION_CRM_CLIENT_ID=
# RDSTATION_CRM_CLIENT_SECRET=
# RDSTATION_CRM_REDIRECT_URI=
# RDSTATION_CRM_WEBHOOK_URL=
# API_PUBLIC_BASE_URL=
# INTEGRATIONS_FERNET_KEY=

# E-mail / SMTP (mesmo da API — worker envia notificacoes)
# EMAIL_HOST=smtp.seudominio.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu-usuario
# EMAIL_HOST_PASSWORD=sua-senha
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# DJANGO_DEFAULT_FROM_EMAIL=BlackBeans <noreply@seudominio.com>
# NOTIFICATION_EMAIL_ENABLED=1
