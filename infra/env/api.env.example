# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=1
# Use pelo menos 32 caracteres para evitar warning de chave curta JWT/HMAC.
DJANGO_SECRET_KEY=change-me-in-real-env-with-at-least-32-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
USE_DOCKER=yes

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=blackbeans
POSTGRES_USER=blackbeans
POSTGRES_PASSWORD=blackbeans
DATABASE_URL=postgres://blackbeans:blackbeans@postgres:5432/blackbeans

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Relatar problema (feedback)
PROBLEM_REPORTS_FEEDBACK_ENABLED=1
PROBLEM_REPORTS_RATE_LIMIT_PER_HOUR=10

# Midia (uploads de tarefas / anexos)
# MEDIA_ROOT padrao no container: /app/blackbeans_api/media
# No Easypanel (API): monte um volume persistente nesse path, senao redeploy apaga os arquivos.
# Mount path (container): /app/blackbeans_api/media

# E-mail / SMTP (obrigatorio para "Testar e-mail" e notificacoes por e-mail)
# Sem EMAIL_HOST o backend local so imprime o e-mail no log do container (console).
# Em producao (Easypanel), configure as mesmas variaveis na API e no worker.
# EMAIL_HOST=smtp.seudominio.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu-usuario
# EMAIL_HOST_PASSWORD=sua-senha
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# DJANGO_DEFAULT_FROM_EMAIL=BlackBeans <noreply@seudominio.com>
# NOTIFICATION_EMAIL_ENABLED=1

# Agentes IA (opcional — sem chave usa briefing fallback)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AGENT_LLM_ENABLED=1
# AGENT_STALE_DAYS=7

# RD Station CRM (OAuth — nunca commitar client_secret)
# RDSTATION_CRM_CLIENT_ID=
# RDSTATION_CRM_CLIENT_SECRET=
# Callback cadastrado no app da RD App Store (HTTPS em producao).
# RDSTATION_CRM_REDIRECT_URI=https://seu-dominio/api/v1/integrations/rdstation/oauth/callback
# URL publica HTTPS do webhook (local: tunnel). Sem HTTPS o cadastro automatico e pulado.
# RDSTATION_CRM_WEBHOOK_URL=https://seu-dominio/api/v1/integrations/rdstation/webhook
# API_PUBLIC_BASE_URL=https://seu-dominio
# Chave para criptografar tokens no banco (32+ chars). Sem ela usa DJANGO_SECRET_KEY.
# INTEGRATIONS_FERNET_KEY=
